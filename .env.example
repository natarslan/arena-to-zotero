# Are.na credentials
# From your OAuth app page at: https://dev.are.na/oauth/applications
ARENA_CLIENT_ID=your_client_id_here
ARENA_CLIENT_SECRET=your_client_secret_here
# Run `python get_token.py` once to generate this, then paste it here
ARENA_ACCESS_TOKEN=your_arena_access_token_here

# Zotero credentials
# Get your API key at: https://www.zotero.org/settings/keys
# Your library ID is in your profile URL: zotero.org/users/<ID>
ZOTERO_API_KEY=your_zotero_api_key_here
ZOTERO_LIBRARY_ID=your_zotero_user_id_here
# Use "user" for personal library, "group" for a group library
ZOTERO_LIBRARY_TYPE=user
